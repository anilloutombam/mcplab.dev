---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
	title="MCP Lab — Failure testing for MCP systems"
	description="Open-source tools for deterministic MCP failure and resilience testing."
	image="/brand/mcp-failure-lab-social-preview.png"
>
	<main class="shell">
		<section class="hero">
			<div class="kicker">MCP Lab / open-source testing tools</div>
			<h1>Test MCP timeouts, disconnects, and protocol response faults.</h1>
			<p class="lede">
				MCP Lab develops focused tools for reproducing failure conditions in Model Context Protocol systems. The first
				project, MCP Failure Lab, runs deterministic scenarios against its built-in server or a configured external MCP
				target.
			</p>
			<div class="actions">
				<a class="button primary" href="/docs/getting-started">Getting started</a><a
					class="button"
					href="https://github.com/anilloutombam/mcp-failure-lab">GitHub repository</a
				>
			</div>
			<div class="project-stats" aria-label="MCP Failure Lab project statistics">
				<a class="project-stat" href="https://www.npmjs.com/package/mcp-failure-lab">
					<span class="project-stat-icon" aria-hidden="true">npm</span>
					<strong data-monthly-downloads aria-label="Loading rolling 30-day downloads">—</strong>
					<span>downloads · last 30 days</span>
				</a>
				<a
					class="project-stat github-star-stat"
					href="https://github.com/anilloutombam/mcp-failure-lab"
					data-github-star-link
				>
					<svg class="github-mark" viewBox="0 0 24 24" aria-hidden="true">
						<path
							fill="currentColor"
							d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.74.4-1.25.73-1.54-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18A10.98 10.98 0 0 1 12 6.14c.98 0 1.95.13 2.86.38 2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.28 5.68.42.36.79 1.07.79 2.16v3.23c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z"
						></path>
					</svg>
					<span>Star on GitHub</span>
					<strong data-github-stars aria-label="Loading GitHub stars">—</strong>
				</a>
			</div>
			<div class="meta">
				<span class="available">Published on npm</span><span>MIT licensed</span><span>Node.js 22.23.4+</span><span
					>stdio + HTTP</span
				>
			</div>
			<div class="registry-links" aria-label="MCP Failure Lab registry listings">
				<span class="registry-prefix">Listed in</span>
				<a
					class="registry-link"
					href="https://registry.modelcontextprotocol.io/?q=io.github.anilloutombam%2Fmcp-failure-lab"
				>
					<span class="mcp-registry-mark" aria-hidden="true"></span>
					<span>Official MCP Registry</span>
				</a>
				<a class="registry-link" href="https://github.com/mcp/anilloutombam/mcp-failure-lab">
					<svg class="registry-github-mark" viewBox="0 0 24 24" aria-hidden="true">
						<path
							fill="currentColor"
							d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.74.4-1.25.73-1.54-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18A10.98 10.98 0 0 1 12 6.14c.98 0 1.95.13 2.86.38 2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.28 5.68.42.36.79 1.07.79 2.16v3.23c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z"
						></path>
					</svg>
					<span>GitHub MCP Registry</span>
				</a>
			</div>
		</section>

		<section class="section">
			<h2 class="section-title">A scenario and its result</h2>
			<p class="section-intro">
				The runner makes a real MCP tool call, records the observed outcome and duration, then evaluates the declared
				expectations.
			</p>
			<div class="example-grid">
				<div class="code-panel">
					<div class="code-label">
						<span>delay-success.json</span><span>input</span>
					</div><pre>&#123;
  <span class="token-key">"name"</span>: <span class="token-string">"bounded delay succeeds"</span>,
  <span class="token-key">"call"</span>: &#123;
    <span class="token-key">"tool"</span>: <span class="token-string">"delay"</span>,
    <span class="token-key">"args"</span>: &#123; <span class="token-key">"delayMs"</span>: 250 &#125;
  &#125;,
  <span class="token-key">"timeoutMs"</span>: 1000,
  <span class="token-key">"expect"</span>: &#123;
    <span class="token-key">"outcome"</span>: <span class="token-string">"success"</span>,
    <span class="token-key">"maxDurationMs"</span>: 500
  &#125;
&#125;</pre>
				</div>
				<div class="code-panel">
					<div class="code-label">
						<span>console</span><span>output</span>
					</div><pre><span class="token-muted">$ npm run dev -- run \
  examples/scenarios/delay-success.json</span>

Scenario:   bounded delay succeeds
Outcome:    <span class="token-pass">success</span>
Duration:   ~250 ms
Assertions: <span class="token-pass">passed</span></pre>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="section-heading-row">
				<div>
					<div class="section-kicker">What you can test</div>
					<h2 class="section-title">Failure paths, grouped by system layer.</h2>
				</div>
				<a class="text-link" href="/docs/fault-tools">Full fault reference <span aria-hidden="true">→</span></a>
			</div>
			<p class="section-intro">
				Start with a focused failure mode, then verify what the same connection—or a new one—can do next.
			</p>
			<div class="capability-grid">
				<article class="capability-card">
					<div class="capability-number" aria-hidden="true">01</div>
					<h3>Timing & cancellation</h3>
					<p>Bounded delays, requests that hang until cancellation, and deliberately late stdio responses.</p>
					<div class="capability-tools">
						<code>delay</code><code>hang</code><code>response_after_cancellation</code>
					</div>
				</article>
				<article class="capability-card">
					<div class="capability-number" aria-hidden="true">02</div>
					<h3>Protocol & response</h3>
					<p>Invalid envelopes, duplicate results, oversized payloads, and broken progress notification sequences.</p>
					<div class="capability-tools">
						<code>malformed_message</code><code>duplicate_response</code><code>oversized_response</code><code
							>invalid_progress</code
						>
					</div>
				</article>
				<article class="capability-card">
					<div class="capability-number" aria-hidden="true">03</div>
					<h3>Transport & session</h3>
					<p>In-flight connection loss and controlled legacy HTTP session invalidation across stdio and HTTP.</p>
					<div class="capability-tools">
						<code>disconnect</code><code>session_loss</code><code>Streamable HTTP</code>
					</div>
				</article>
				<article class="capability-card">
					<div class="capability-number" aria-hidden="true">04</div>
					<h3>Verify & report</h3>
					<p>Check recovery and protocol liveness, then produce stable console, JSON, or JUnit results for CI.</p>
					<div class="capability-tools">
						<code>ping</code><code>protocol_ping_liveness</code><code>JSON + JUnit</code>
					</div>
				</article>
			</div>
			<div class="actions">
				<a class="button primary" href="/docs/getting-started">Run your first scenario</a><a
					class="button"
					href="/failure">Project details</a
				>
			</div>
		</section>

		<section class="section split">
			<div>
				<h3>What it is</h3><p>
					A deterministic test server, scenario runner, assertion model, and CLI for exercising known MCP failure paths.
				</p>
			</div><div>
				<h3>What it is not</h3><p>
					It is not a general-purpose proxy or protocol compliance suite. External execution is limited to configured
					MCP targets and declared scenarios.
				</p>
			</div>
		</section>
	</main>
	<script is:inline>
		const statsCacheKey = 'mcp-failure-lab-project-stats-v2';
		const statsCacheLifetime = 60 * 60 * 1000;
		const downloadsElement = document.querySelector('[data-monthly-downloads]');
		const starsElement = document.querySelector('[data-github-stars]');
		const starsLinkElement = document.querySelector('[data-github-star-link]');
		const numberFormatter = new Intl.NumberFormat();
		const formatDownloads = (downloads) => {
			if (downloads >= 1_000_000) return `${Math.floor(downloads / 100_000) / 10}M`;
			if (downloads >= 1_000) return `${Math.floor(downloads / 100) / 10}K`;
			return numberFormatter.format(downloads);
		};

		const renderDownloads = (downloads) => {
			if (downloadsElement && Number.isFinite(downloads)) {
				downloadsElement.textContent = formatDownloads(downloads);
				downloadsElement.removeAttribute('aria-label');
			}
		};

		const renderStars = (stars) => {
			if (starsElement && Number.isFinite(stars)) {
				starsElement.textContent = numberFormatter.format(stars);
				starsElement.removeAttribute('aria-label');
				starsLinkElement?.setAttribute(
					'aria-label',
					`Star MCP Failure Lab on GitHub. ${numberFormatter.format(stars)} ${stars === 1 ? 'star' : 'stars'}.`,
				);
			}
		};

		let cachedStats;
		try {
			cachedStats = JSON.parse(localStorage.getItem(statsCacheKey) ?? 'null');
		} catch {
			localStorage.removeItem(statsCacheKey);
		}

		if (cachedStats) {
			renderDownloads(cachedStats.downloadsLast30Days);
			renderStars(cachedStats.stars);
		}

		if (!cachedStats || Date.now() - cachedStats.updatedAt > statsCacheLifetime) {
			Promise.allSettled([
				fetch('https://api.npmjs.org/downloads/point/last-month/mcp-failure-lab').then((response) => {
					if (!response.ok) throw new Error('npm statistics request failed');
					return response.json();
				}),
				fetch('https://api.github.com/repos/anilloutombam/mcp-failure-lab/stargazers/count', {
					headers: { Accept: 'application/vnd.github+json', 'X-GitHub-Api-Version': '2026-03-10' },
				}).then((response) => {
					if (!response.ok) throw new Error('GitHub statistics request failed');
					return response.json();
				}),
			]).then(([downloadsResult, starsResult]) => {
				const downloadsLast30Days =
					downloadsResult.status === 'fulfilled' ? downloadsResult.value.downloads : cachedStats?.downloadsLast30Days;
				const stars = starsResult.status === 'fulfilled' ? starsResult.value.count : cachedStats?.stars;

				renderDownloads(downloadsLast30Days);
				renderStars(stars);

				if (Number.isFinite(downloadsLast30Days) || Number.isFinite(stars)) {
					localStorage.setItem(statsCacheKey, JSON.stringify({ downloadsLast30Days, stars, updatedAt: Date.now() }));
				}
			});
		}
	</script>
</SiteLayout>
