---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
const { title, description, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImage = image ? new URL(image, Astro.site ?? Astro.url) : undefined;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head
		><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta
			name="theme-color"
			content="#090a0c"
		/><meta name="description" content={description} /><link rel="icon" type="image/png" href="/favicon.png" /><link
			rel="canonical"
			href={canonical}
		/><meta property="og:type" content="website" /><meta property="og:site_name" content="MCP Lab" /><meta
			property="og:title"
			content={title}
		/><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />{
			socialImage && <meta property="og:image" content={socialImage} />
		}<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} /><meta
			name="twitter:title"
			content={title}
		/><meta name="twitter:description" content={description} />{
			socialImage && <meta name="twitter:image" content={socialImage} />
		}<title>{title}</title><script is:inline>
			const savedTheme = localStorage.getItem('starlight-theme');
			const resolvedTheme =
				savedTheme === 'light' || savedTheme === 'dark'
					? savedTheme
					: matchMedia('(prefers-color-scheme: dark)').matches
						? 'dark'
						: 'light';
			localStorage.setItem('starlight-theme', resolvedTheme);
			document.documentElement.dataset.theme = resolvedTheme;
			document.documentElement.dataset.themePreference = resolvedTheme;
		</script><Analytics /></head
	><body>
		<header class="site-header">
			<div class="shell">
				<nav class="nav" aria-label="Main navigation">
					<a class="brand" href="/" aria-label="MCP Lab home"><span class="mark"></span><span>MCP LAB</span></a><div
						class="links"
					>
						<a class="nav-link" href="/failure" aria-current={path.startsWith('/failure') ? 'page' : undefined}
							>Failure Lab</a
						><a class="nav-link" href="/docs" aria-current={path.startsWith('/docs') ? 'page' : undefined}>Docs</a><a
							class="nav-link support-link"
							href="/support"
							aria-current={path.startsWith('/support') ? 'page' : undefined}>♡ Support</a
						><a class="nav-link" href="https://github.com/anilloutombam/mcp-failure-lab">GitHub</a><button
							class="theme-toggle"
							type="button"
							role="switch"
							data-theme-toggle
							aria-label="Switch to light theme"
							aria-checked="true"
							><span class="theme-sun" aria-hidden="true">☀</span><span class="theme-moon" aria-hidden="true">☾</span
							></button
						><a class="button nav-cta" href="/docs/getting-started">Get started <span aria-hidden="true">→</span></a>
					</div>
				</nav>
			</div>
		</header>
		<slot />
		<footer class="site-footer">
			<div class="shell footer-grid">
				<div>
					<a class="brand footer-brand" href="/"><span class="mark"></span><span>MCP LAB</span></a><p>
						Open-source tools for testing failure behavior in MCP systems.
					</p>
				</div><div class="footer-links">
					<div>
						<strong>Project</strong><a href="/failure">Failure Lab</a><a href="/docs/getting-started">Getting started</a
						><a href="/docs/examples">Examples</a>
					</div><div>
						<strong>Reference</strong><a href="/docs/fault-tools">Fault tools</a><a href="/docs/cli">CLI</a><a
							href="/docs/architecture">Architecture</a
						>
					</div><div>
						<strong>Source</strong><a href="https://github.com/anilloutombam/mcp-failure-lab">GitHub</a><a
							href="https://github.com/anilloutombam/mcp-failure-lab/releases/latest">Latest release</a
						><a href="/support">♡ Support</a>
					</div>
				</div>
			</div><div class="shell footer-bottom">
				<span>© 2026 MCP Lab</span><span>Documentation tracks implemented behavior.</span>
			</div>
		</footer>
		<script is:inline>
			const applyTheme = (preference) => {
				document.documentElement.dataset.theme = preference;
				document.documentElement.dataset.themePreference = preference;
				localStorage.setItem('starlight-theme', preference);
				document
					.querySelector('meta[name="theme-color"]')
					?.setAttribute('content', preference === 'dark' ? '#090a0c' : '#f6f7f9');
				const toggle = document.querySelector('[data-theme-toggle]');
				toggle?.setAttribute('aria-checked', String(preference === 'dark'));
				toggle?.setAttribute('aria-label', preference === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
				toggle?.setAttribute('title', preference === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
			};
			document
				.querySelector('[data-theme-toggle]')
				?.addEventListener('click', () =>
					applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'),
				);
			applyTheme(localStorage.getItem('starlight-theme') === 'light' ? 'light' : 'dark');
		</script></body
	>
</html>
